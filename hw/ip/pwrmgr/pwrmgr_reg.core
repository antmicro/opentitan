name: "lowrisc:ip:pwrmgr_reg:0.1"
description: "Power manager registers"

filesets:
  files_rtl:
    depend:
      - lowrisc:tlul:headers
      - lowrisc:prim:subreg
      - "!fileset_topgen ? (ot_is_earlgrey ? (lowrisc:systems_earlgrey:pwrmgr_reg))"
      - "!fileset_topgen ? (ot_is_custom_tiny ? (lowrisc:systems_custom_tiny:pwrmgr_reg))"
      - "fileset_topgen ? (lowrisc:systems:topgen-reg-only)"
    files:
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_rtl
